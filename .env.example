# ==========================================
# Prodrome Environment Variables (Template)
# ==========================================

# PostgreSQL connection string or SQLite local fallback (e.g., sqlite:///clinical_sessions.db)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>

# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 256-bit AES encryption secret key for decoupled zero-knowledge identity vault
VAULT_SECRET_KEY=your_vault_secret_key_here
